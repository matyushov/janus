# Parameters of janus-receiverd (read by the systemd unit).
# The file is marked as a conffile: edits survive a package upgrade.

# Address of the gRPC listener (mTLS).
JANUS_LISTEN=0.0.0.0:7443

# Parent directory of the per-machine stores (each machine gets its own subdirectory, named in
# the machines file). Backup data is NOT erased when the package is removed.
JANUS_STORE=/var/lib/janus/store

# Quota in bytes for machines whose entry in the machines file has none; 0 = no limit.
JANUS_QUOTA=0

# --- mTLS (REQUIRED: without these four the daemon refuses to start) -------------------------
# Server certificate and private key (PEM). Keep the key 0600 (readable by the janus user only);
# the daemon warns when it is wider.
JANUS_TLS_CERT=/etc/janus/tls/server.pem
JANUS_TLS_KEY=/etc/janus/tls/server.key
# CA (PEM) that signs the CLIENT certificates; a client without a certificate from this CA is
# rejected during the TLS handshake. TLS 1.3 is the minimum.
JANUS_TLS_CA=/etc/janus/tls/ca.pem
# Machines file (JSON, 0600): SHA-256 fingerprint of a client certificate -> machine id ->
# store subdirectory -> quota. A certificate that is not listed gets PERMISSION_DENIED.
# Format and an example: crates/janus-receiverd/README.md; a helper that writes the file for
# throw-away certificates: tools/dev-pki.sh
JANUS_MACHINES=/etc/janus/machines.json
