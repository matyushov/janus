# Parameters of janus-smbd (read by the systemd unit).
# The mount point and backend are set through the control plane:
#   janus-cli smbd configure --endpoint … --client-cert … --client-key … --ca … [--port N] [--share NAME]
# Here is only what the daemon needs before the first configuration.

# Directory of the local journal (WAL); see the documentation.
JANUS_SMBD_STATE=/var/lib/janus/smbd
